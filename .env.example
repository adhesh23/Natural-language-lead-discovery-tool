# Environment Variables & API Keys Template
# Copy this file to .env and fill in your own valid API keys.

# Stage 1: Exa Discovery (https://exa.ai)
# Supports single key or numbered keys for multi-key credit fallback:
EXA_API_KEY=your_exa_api_key_here
# EXA_API_KEY_1=
# EXA_API_KEY_2=
# EXA_API_KEY_3=

# Stage 2: Firecrawl Web Scraping (https://firecrawl.dev)
# Supports single key or numbered keys for multi-key credit fallback:
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
# FIRECRAWL_API_KEY_1=
# FIRECRAWL_API_KEY_2=
# FIRECRAWL_API_KEY_3=

# Stage 3: Tavily Search (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Stage 4: NVIDIA NIM LLM Evaluation (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
# NIM_API_KEY=your_nvidia_api_key_here

# Supporting / Optional Sources
SERPER_API_KEY=your_serper_api_key_here
PRODUCT_HUNT_CLIENT_ID=your_ph_client_id_here
PRODUCT_HUNT_CLIENT_SECRET=your_ph_client_secret_here
NEWSAPI_KEY=your_newsapi_key_here
GNEWS_API_KEY=your_gnews_api_key_here
